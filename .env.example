# ============================================================================
# mcp-coordinator environment configuration
# Copy to .env and customize for your deployment.
# ============================================================================

# --- Core ---
# PORT=3100
# COORDINATOR_DATA_DIR=./data

# --- Authentication (v0.7+) ---
# Master switch. When `true`, all /api/* requires JWT.
# COORDINATOR_AUTH_ENABLED=false

# HS256 signing key. MUST be set in prod — without it, a random secret is
# generated per boot and every restart invalidates all sessions.
# COORDINATOR_JWT_SECRET=change-me-to-32-chars-or-more-please

# JWT TTL (default 24h)
# COORDINATOR_JWT_EXPIRY=24h

# Optional: previous signing key for zero-downtime rotation.
# Set both `_SECRET` (new) and `_PREV_SECRET` (old), restart, wait one JWT TTL,
# then remove `_PREV_SECRET` and restart again.
# COORDINATOR_JWT_PREV_SECRET=previous-secret-here

# --- Phase 2 (v0.7.1) preview — not active in Phase 1 ---
# Public base URL for OAuth callbacks (required when AUTH_ENABLED=true with OAuth)
# COORDINATOR_PUBLIC_URL=https://coord.example.com

# GitHub OAuth (Phase 2)
# COORDINATOR_GITHUB_CLIENT_ID=
# COORDINATOR_GITHUB_CLIENT_SECRET=

# Token lifetimes (Phase 2 defaults shown)
# COORDINATOR_REFRESH_TOKEN_TTL_DAYS=30
# COORDINATOR_AGENT_JWT_TTL_SECONDS=900
# COORDINATOR_DEVICE_FLOW_TTL_SECONDS=600

# --- Phase 4 preview ---
# COORDINATOR_GOOGLE_CLIENT_ID=
# COORDINATOR_GOOGLE_CLIENT_SECRET=
# COORDINATOR_OIDC_ISSUER_URL=
# COORDINATOR_OIDC_CLIENT_ID=
# COORDINATOR_OIDC_CLIENT_SECRET=
