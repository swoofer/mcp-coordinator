# ============================================================================
# mcp-coordinator environment configuration
#
# Copy to .env and fill in. The file lives at the repo root and is loaded
# automatically by the coordinator on boot.
#
# Lines marked PHASE 1 work without Phase 2 OAuth (default Phase 1 mode).
# Lines marked PHASE 2 are only read when COORDINATOR_OAUTH_ENABLED=true.
#
# See:
#   docs/onboarding-self-host.md       -- end-to-end setup walkthrough
#   docs/ops/upgrade-phase1-to-phase2.md -- migrating from v0.7.x
#   docs/security/threat-model.md      -- STRIDE-by-asset model
# ============================================================================


# ---------------------------------------------------------------------------
# Phase 1 settings (always read; safe defaults shown)
# ---------------------------------------------------------------------------

# HTTP listener port (default 3100).
# PORT=3100

# Path to the SQLite database directory. Created on first boot with mode 0700
# on POSIX. Default: ./data
# COORDINATOR_DATA_DIR=./data

# AUTH_ENABLED: when "true", every /api/* request requires a Bearer JWT
# verified against COORDINATOR_JWT_SECRET. Default: false.
# Independent of Phase 2 -- Phase 1 JWTs continue to verify under Phase 2 too.
# COORDINATOR_AUTH_ENABLED=false

# JWT signing secret. REQUIRED when AUTH_ENABLED=true (and when Phase 2 is on).
# Minimum 32 random bytes. Boot rejects dictionary words, all-zero / all-same
# bytes, and low-Shannon-entropy strings.
# Generate via:
#   openssl rand -base64 32
# COORDINATOR_JWT_SECRET=

# Phase 1 JWT TTL (default 24h). Phase 2 uses dedicated access/refresh TTLs
# below; this remains the Phase 1 Bearer TTL.
# COORDINATOR_JWT_EXPIRY=24h

# Previous Phase 1 signing key for zero-downtime rotation. Set both _SECRET
# (new) and _PREV_SECRET (old), restart, wait one JWT TTL, then unset
# _PREV_SECRET and restart again. See docs/ops/key-rotation.md.
# COORDINATOR_JWT_PREV_SECRET=


# ---------------------------------------------------------------------------
# Phase 2 settings (read when COORDINATOR_OAUTH_ENABLED=true)
# ---------------------------------------------------------------------------

# Master switch for Phase 2 OAuth + device flow + cookie sessions + audit
# pipeline + sweeper. Default: false. When unset/false, v0.8.0 behaves
# byte-identically to v0.7.0 (verified by tests/backcompat/, T43).
# COORDINATOR_OAUTH_ENABLED=false

# Public URL of this coordinator (e.g. https://coordinator.example.com).
# Used as the JWT issuer, the OAuth redirect_uri, and (implicitly) the cookie
# scope. Must be http:// or https://. http:// non-localhost requires
# COORDINATOR_INSECURE_COOKIES=true (NOT for production).
# COORDINATOR_PUBLIC_URL=

# GitHub OAuth app credentials. Create at:
#   https://github.com/settings/applications/new
# Authorization callback URL:
#   ${COORDINATOR_PUBLIC_URL}/api/auth/oauth/callback
# COORDINATOR_GITHUB_CLIENT_ID=
# COORDINATOR_GITHUB_CLIENT_SECRET=

# Allowed GitHub organization. Users not in this org are denied at sign-in
# and at every refresh (V4 FIX 7 re-check). Seeds the orgs.allowlist_github_org
# row on first boot.
# COORDINATOR_GITHUB_ORG=

# GitHub Enterprise Server (GHES) base URLs. Unset = github.com defaults.
# Used by GitHubProvider for the OAuth authorize/token + REST API.
# Both validated at boot: must parse as a URL and use http:// or https://.
# See examples/ghes-config/ for a complete GHES deployment example.
# COORDINATOR_GITHUB_AUTH_BASE_URL=https://github.example.com
# COORDINATOR_GITHUB_API_BASE_URL=https://github.example.com/api/v3

# Previous JWT signing secret for rotation overlap (v0.8.1+).
# Set ONCE during rotation: assign current secret to _PREV, generate new
# secret, assign to JWT_SECRET. Old kid "hs256-v0" verifies; new kid
# "hs256-v1" signs. Unset PREV after overlap window completes.
# Subject to the same 128-bit entropy floor as COORDINATOR_JWT_SECRET.
# COORDINATOR_JWT_SECRET_PREV=

# Optional ISO timestamp recorded in config.key_rotation Tier 1 audit
# for correlation across deployments. Advisory only -- the coordinator
# does not parse it. Example: 2026-05-15T14:00:00Z
# COORDINATOR_JWT_SECRET_PREV_ROTATED_AT=

# JWT access-token TTL. Default 15m, max 60m.
# COORDINATOR_JWT_ACCESS_TTL=15m

# Refresh-token TTL. Default 30d, max 90d.
# COORDINATOR_JWT_REFRESH_TTL=30d

# Auto-provision new users on first OAuth login. Default: true.
# Set to "false" for regulated deployments requiring admin pre-creation.
# COORDINATOR_AUTO_PROVISION=true

# Idle session timeout: invalidate refresh after N of inactivity (V4 FIX 7).
# Unset = no idle check. Recommended: 15m for regulated workloads.
# COORDINATOR_SESSION_IDLE_TIMEOUT=

# Login-lockout policy (defaults match V3 §B-NEW-8).
# COORDINATOR_LOGIN_LOCKOUT_THRESHOLD=5
# COORDINATOR_LOGIN_LOCKOUT_WINDOW=15m
# COORDINATOR_LOGIN_LOCKOUT_DURATION=15m

# Sweeper retention windows (V3 NR13 two-tier durability).
# COORDINATOR_REFRESH_RETENTION_DAYS=180
# COORDINATOR_AUDIT_RETENTION_DAYS=365         # Tier 1 (security-critical)
# COORDINATOR_AUDIT_TIER2_RETENTION_DAYS=90    # Tier 2 (operational)


# ---------------------------------------------------------------------------
# Operational overrides (use sparingly)
# ---------------------------------------------------------------------------

# WARNING: HTTP-only override. NOT for production. Required if
# COORDINATOR_PUBLIC_URL starts with http:// and the host is not localhost.
# Drops the Secure flag from session cookies so HTTP-only deployments work
# for local development. Use a reverse proxy with TLS termination instead.
# COORDINATOR_INSECURE_COOKIES=false

# WARNING: Restore-from-backup override (NR12). Set to "true" ONCE after
# restoring data/coordinator.db from a backup, then unset before the NEXT
# boot. Triggers bumpTokenEpochAllUsers, invalidating every refresh token
# in circulation -- mandatory because the restored DB may have been forked
# from the cluster's audit timeline.
# COORDINATOR_ALLOW_RESTORE=false

# Bearer token for /metrics/auth. If unset, /metrics/auth is reachable only
# from localhost. Set to a long random token to expose metrics to a remote
# Prometheus scraper.
# Generate via:
#   openssl rand -hex 32
# COORDINATOR_METRICS_BEARER=


# ---------------------------------------------------------------------------
# Phase 4 preview (not active in v0.8.0; see docs/idp-providers.md)
# ---------------------------------------------------------------------------

# Reserved for the Phase 4 IdP registry. Setting these in v0.8.0 has no
# effect -- the providers registry currently ships GitHub only.
# COORDINATOR_GOOGLE_CLIENT_ID=
# COORDINATOR_GOOGLE_CLIENT_SECRET=
# COORDINATOR_OIDC_ISSUER_URL=
# COORDINATOR_OIDC_CLIENT_ID=
# COORDINATOR_OIDC_CLIENT_SECRET=
