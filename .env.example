# ============================================================================
# mcp-coordinator environment configuration
#
# Copy to .env and fill in. The file lives at the repo root and is loaded
# automatically by the coordinator on boot.
#
# Lines marked PHASE 1 work without Phase 2 OAuth (default Phase 1 mode).
# Lines marked PHASE 2 are only read when COORDINATOR_OAUTH_ENABLED=true.
#
# See:
#   docs/onboarding-self-host.md       -- end-to-end setup walkthrough
#   docs/ops/upgrade-phase1-to-phase2.md -- migrating from v0.7.x
#   docs/security/threat-model.md      -- STRIDE-by-asset model
# ============================================================================


# ---------------------------------------------------------------------------
# Phase 1 settings (always read; safe defaults shown)
# ---------------------------------------------------------------------------

# HTTP listener port (default 3100).
# PORT=3100

# Path to the SQLite database directory. Created on first boot with mode 0700
# on POSIX. Default: ./data
# COORDINATOR_DATA_DIR=./data

# How long an agent stays in the "online" list without being seen (seconds,
# default 900). Liveness is refreshed by real work -- announce_work and
# post_to_thread, not only the explicit `heartbeat` tool -- so this is the idle
# window before list_agents(online_only), coordinator_status and wait_for_peers
# stop counting an agent. Filters at read time and never deletes the row:
# list_agents without online_only still shows it. Raise it if agents routinely
# think for longer than 15 minutes between coordination calls. (issue #233)
# COORDINATOR_AGENT_ONLINE_TTL_SECONDS=900

# AUTH_ENABLED: when "true", every /api/* request requires a Bearer JWT
# verified against COORDINATOR_JWT_SECRET. Default: false.
# Independent of Phase 2 -- Phase 1 JWTs continue to verify under Phase 2 too.
# COORDINATOR_AUTH_ENABLED=false

# JWT signing secret. REQUIRED when AUTH_ENABLED=true (and when Phase 2 is on).
# Minimum 32 random bytes. Boot rejects dictionary words, all-zero / all-same
# bytes, and low-Shannon-entropy strings.
# Generate via:
#   openssl rand -base64 32
# COORDINATOR_JWT_SECRET=

# Phase 1 JWT TTL (default 24h). Phase 2 uses dedicated access/refresh TTLs
# below; this remains the Phase 1 Bearer TTL.
# COORDINATOR_JWT_EXPIRY=24h

# Previous Phase 1 signing key for zero-downtime rotation. Set both _SECRET
# (new) and _PREV_SECRET (old), restart, wait one JWT TTL, then unset
# _PREV_SECRET and restart again. See docs/ops/key-rotation.md.
# COORDINATOR_JWT_PREV_SECRET=


# ---------------------------------------------------------------------------
# Phase 2 settings (read when COORDINATOR_OAUTH_ENABLED=true)
# ---------------------------------------------------------------------------

# Master switch for Phase 2 OAuth + device flow + cookie sessions + audit
# pipeline + sweeper. Default: false. When unset/false, v0.8.0 behaves
# byte-identically to v0.7.0 (verified by tests/backcompat/, T43).
# COORDINATOR_OAUTH_ENABLED=false

# Public URL of this coordinator (e.g. https://coordinator.example.com).
# Used as the JWT issuer, the OAuth redirect_uri, and (implicitly) the cookie
# scope. Must be http:// or https://. http:// non-localhost requires
# COORDINATOR_INSECURE_COOKIES=true (NOT for production).
# COORDINATOR_PUBLIC_URL=

# GitHub OAuth app credentials. Optional (both-or-neither): configure them
# to offer GitHub sign-in. A Google-only or OIDC-only deployment can leave
# them unset — at least one IdP provider just has to be configured overall.
# Create at:
#   https://github.com/settings/applications/new
# Authorization callback URL:
#   ${COORDINATOR_PUBLIC_URL}/api/auth/oauth/callback
# COORDINATOR_GITHUB_CLIENT_ID=
# COORDINATOR_GITHUB_CLIENT_SECRET=

# Allowed GitHub organization. Users not in this org are denied at sign-in
# and at every refresh (V4 FIX 7 re-check). Seeds the orgs.allowlist_github_org
# row on first boot. REQUIRED when the GitHub OAuth App above is configured;
# ignored otherwise.
# COORDINATOR_GITHUB_ORG=

# GitHub Enterprise Server (GHES) base URLs. Unset = github.com defaults.
# Used by GitHubProvider for the OAuth authorize/token + REST API.
# Both validated at boot: must parse as a URL and use http:// or https://.
# See examples/ghes-config/ for a complete GHES deployment example.
# COORDINATOR_GITHUB_AUTH_BASE_URL=https://github.example.com
# COORDINATOR_GITHUB_API_BASE_URL=https://github.example.com/api/v3

# Previous JWT signing secret for rotation overlap (v0.8.1+).
# Set ONCE during rotation: assign current secret to _PREV, generate new
# secret, assign to JWT_SECRET. Old kid "hs256-v0" verifies; new kid
# "hs256-v1" signs. Unset PREV after overlap window completes.
# Subject to the same 128-bit entropy floor as COORDINATOR_JWT_SECRET.
# COORDINATOR_JWT_SECRET_PREV=

# Optional ISO timestamp recorded in config.key_rotation Tier 1 audit
# for correlation across deployments. Advisory only -- the coordinator
# does not parse it. Example: 2026-05-15T14:00:00Z
# COORDINATOR_JWT_SECRET_PREV_ROTATED_AT=

# JWT access-token TTL. Default 15m, max 60m.
# COORDINATOR_JWT_ACCESS_TTL=15m

# Refresh-token TTL. Default 30d, max 90d.
# COORDINATOR_JWT_REFRESH_TTL=30d

# Auto-provision new users on first OAuth login. Default: true.
# Set to "false" for regulated deployments requiring admin pre-creation.
# COORDINATOR_AUTO_PROVISION=true

# Idle session timeout: invalidate refresh after N of inactivity (V4 FIX 7).
# Unset = no idle check. Recommended: 15m for regulated workloads.
# COORDINATOR_SESSION_IDLE_TIMEOUT=

# Login-lockout policy: 5 failed attempts within 15 minutes triggers a
# 15-minute lockout (V3 §B-NEW-8). NOT CONFIGURABLE — these values are
# hardcoded in src/auth/login-lockout.ts (DEFAULT_LOCKOUT_THRESHOLD /
# DEFAULT_LOCKOUT_WINDOW_SECONDS) and the callsite in oauth-callback.ts does
# not read env vars to override them. Listed here for reference only.

# Sweeper retention windows (V3 NR13 two-tier durability).
# COORDINATOR_REFRESH_RETENTION_DAYS=180
# COORDINATOR_AUDIT_RETENTION_DAYS=365         # Tier 1 (security-critical)
# COORDINATOR_AUDIT_TIER2_RETENTION_DAYS=90    # Tier 2 (operational)


# ---------------------------------------------------------------------------
# Operational overrides (use sparingly)
# ---------------------------------------------------------------------------

# WARNING: NOT for production. Required if COORDINATOR_PUBLIC_URL starts
# with http:// and the host is not localhost — bypasses that ONE boot
# validation check, nothing else. securite-auth-05: despite the name, this
# does NOT drop the Secure flag from Phase 2 session/CSRF cookies. Those are
# __Host--prefixed and RFC 6265bis requires __Host- cookies to always carry
# Secure, so they remain Secure regardless of this flag. Practical effect:
# if you actually serve Phase 2 over plain http:// on a non-localhost host,
# boot succeeds but browsers silently reject every Set-Cookie and auth will
# appear broken (a boot-time warning is logged when this is set — see
# src/boot.ts:warnOnInsecureCookiesFlag). Use a reverse proxy with TLS
# termination for any non-localhost deployment instead of setting this.
# COORDINATOR_INSECURE_COOKIES=false

# WARNING: Restore-from-backup override (NR12). Set to "true" ONCE after
# restoring data/coordinator.db from a backup, then unset before the NEXT
# boot. Triggers bumpTokenEpochAllUsers, invalidating every refresh token
# in circulation -- mandatory because the restored DB may have been forked
# from the cluster's audit timeline.
# COORDINATOR_ALLOW_RESTORE=false

# Bearer token for /metrics/auth. If unset, /metrics/auth is reachable only
# from localhost. Set to a long random token to expose metrics to a remote
# Prometheus scraper.
# Generate via:
#   openssl rand -hex 32
# COORDINATOR_METRICS_BEARER=


# ---------------------------------------------------------------------------
# Encryption at rest for IdP tokens (v0.10.5)
# ---------------------------------------------------------------------------

# Encrypt OAuth IdP tokens (idp_access_token, idp_refresh_token) at rest in
# coordinator.db. When unset, tokens are stored plaintext (warning logged at
# boot -- ERROR level in production).
# Generate: openssl rand -base64 32
# Security note: env vars are visible to `docker inspect <container>`. For
# production Docker deploys, mount the value via Docker/Kubernetes secret. A
# future version will support COORDINATOR_ENCRYPTION_KEY_FILE=<path> reading.
# COORDINATOR_ENCRYPTION_KEY=<32 random bytes, base64>


# ---------------------------------------------------------------------------
# Multi-IdP (v0.9.0). Each provider is opt-in; at least one must be
# configured when COORDINATOR_OAUTH_ENABLED=true (boot fails closed with
# none). The first-registered provider is the implicit default; when 2+ are
# registered, /auth/login renders a picker. GitHub registers first when
# configured, so it stays the default for existing GitHub deployments.
# ---------------------------------------------------------------------------

# Google OAuth 2.0 / OIDC. Both vars are required together; setting only
# one is a fail-closed boot error. id_tokens are verified against Google's
# JWKS with RS256 + iss + aud checks.
# COORDINATOR_GOOGLE_CLIENT_ID=
# COORDINATOR_GOOGLE_CLIENT_SECRET=

# Google Workspace hosted-domain allowlist bootstrap. When set (and Google
# is configured), boot seeds an orgs row with allowlist_idp_org_id=<domain>
# so the first Google sign-in from that Workspace can match an org and
# become admin — the Google equivalent of COORDINATOR_GITHUB_ORG. Matched
# case-insensitively against the user's `hd` claim; personal @gmail.com
# accounts (no `hd`) are denied. Set without Google configured = fail-closed
# boot error.
# COORDINATOR_GOOGLE_WORKSPACE_DOMAIN=

# GitHub App (v0.10.0). Sibling to the OAuth App credentials above; both
# can be registered simultaneously. App user-to-server tokens have an 8h
# TTL with refresh-token rotation. Both client_id+secret are required
# together; partial config is a fail-closed boot error. NAME is the
# registry key (and users.idp_provider value); default "github-app".
# Shares COORDINATOR_GITHUB_AUTH_BASE_URL / _API_BASE_URL with the
# OAuth App provider for GHES support.
# COORDINATOR_GITHUB_APP_CLIENT_ID=
# COORDINATOR_GITHUB_APP_CLIENT_SECRET=
# COORDINATOR_GITHUB_APP_NAME=github-app

# T57 (v0.10.3): controls how the App provider sources the allowlist
# candidate list. Default "user_orgs" mirrors OAuth App behaviour
# (calls /user/orgs). "user_installations" calls /user/installations
# and matches the App's installation footprint against
# orgs.allowlist_github_org -- uninstalling the App from an org
# becomes a hard revoke for that org with no coordinator config
# change required. No App RSA private key needed; the user's
# user-to-server token is sufficient.
# COORDINATOR_GITHUB_APP_ALLOWLIST_SOURCE=user_orgs

# Generic OpenID Connect (Okta, Auth0, Azure AD, Keycloak, Authentik, ...).
# All three vars are required together. The issuer URL drives discovery via
# <issuer>/.well-known/openid-configuration; endpoints + JWKS auto-discover
# at first /auth/login.
#
# Must be https:// unless the host is loopback (issue #304). Over plain http
# the discovery document can be rewritten in transit, and that document is
# what decides where the client_secret is sent.
#
# The document's `issuer` field must equal this value, but note what that
# check is and is not: it catches a misconfigured deployment or a redirect to
# a different issuer's document. It is NOT a defence against a poisoned one --
# whoever controls the document controls that field too. What constrains it is
# the origin rule below.
# COORDINATOR_OIDC_ISSUER_URL=
# COORDINATOR_OIDC_CLIENT_ID=
# COORDINATOR_OIDC_CLIENT_SECRET=

# Origins the discovery document may name for authorization_endpoint,
# token_endpoint and jwks_uri, beyond the issuer's own. Comma-separated.
# Unset means strict: issuer origin only.
#
# Real IdPs do split them -- Google issues from accounts.google.com but serves
# tokens from oauth2.googleapis.com and its JWKS from www.googleapis.com. If
# boot refuses your IdP's endpoints, this is the declaration that allows them,
# and the point is that it lives in YOUR config rather than in a document a
# remote host controls. The error message names the origin it refused.
# COORDINATOR_OIDC_EXTRA_ORIGINS=https://oauth2.googleapis.com,https://www.googleapis.com

# T58 (v0.10.4): optional dot-notation path into the id_token where
# group / role memberships live. When set, OIDCProvider's allowlist
# strategy switches to "id_token_groups" and matches IdpUserInfo.groups
# against orgs.allowlist_github_org (case-insensitive). Common values:
#   - groups              (Okta, Auth0, Authentik)
#   - realm_access.roles  (Keycloak)
# Leave unset to keep the default "deny-by-default" posture.
# COORDINATOR_OIDC_GROUPS_CLAIM=groups


# ---------------------------------------------------------------------------
# Phase 1 — coordination layer knobs (always read; safe defaults shown)
# ---------------------------------------------------------------------------

# Repo root for Layer 4 git co-change scoring + path-guard + filesystem
# fallback. UNSET disables Layer 4 entirely (team-mode default). Set to an
# absolute repo path to enable co-change detection — requires `git` on PATH.
# COORDINATOR_REPO_ROOT=

# Layer 4 git co-change tuning. The scorer walks bounded `git log` (capped at
# _MAX_COMMITS, `--since=<_SINCE_DAYS>`), with a 5s timeout and a denylist of
# lockfiles / dist / snapshots. Comma-separated globs in _DENYLIST APPEND to
# the built-in defaults. _REFRESH_INTERVAL_MS controls cache refresh on
# success; _RETRY_MS controls retry cadence on timeout.
# COORDINATOR_LAYER4_DENYLIST=
# COORDINATOR_LAYER4_SINCE_DAYS=7
# COORDINATOR_LAYER4_MAX_COMMITS=2000
# COORDINATOR_LAYER4_REFRESH_INTERVAL_MS=1800000
# COORDINATOR_LAYER4_RETRY_MS=300000

# Working-files in-flight tracker. _TTL_MIN is how long a `working_files`
# claim survives without a heartbeat (default 30 min). _SWEEP_INTERVAL_MS
# is the periodic sweep cadence that expires stale claims.
# COORDINATOR_WORKING_FILES_TTL_MIN=30
# COORDINATOR_WORKING_FILES_SWEEP_INTERVAL_MS=60000

# parseBody hard cap on POST bodies (default 1 MB → HTTP 413 on overflow).
# COORDINATOR_MAX_BODY_BYTES=1048576

# WebSocket path for MQTT-over-WebSocket on the HTTP port (default /mqtt).
# COORDINATOR_MQTT_WS_PATH=/mqtt

# MQTT broker TCP port (default 1883, bound 127.0.0.1).
# COORDINATOR_MQTT_TCP_PORT=1883

# Anthropic quota pre-flight abort threshold (%). When utilization exceeds
# this, orchestrators reading coordinator_status.quota typically abort.
# MAX_QUOTA_PCT=95

# Bind address (default 127.0.0.1). Use 0.0.0.0 to expose on LAN.
# COORDINATOR_BIND=127.0.0.1

# Logging.
# LOG_LEVEL=info          # debug / info / warn / error
# NODE_ENV=               # set to "development" for pretty human-readable logs


# ---------------------------------------------------------------------------
# Schema migration escape hatch (v0.11 / issue #231)
# ---------------------------------------------------------------------------

# Boot refuses to migrate a database in which a coordination row references an
# agent id that exists in no org (threads.initiator_id, thread_messages,
# action_summaries, introspections, agent_activity_status). Such a database
# already violates its current foreign key; the org that row belongs to cannot
# be derived, and dropping coordination history to let a schema change proceed
# is not the migration's call to make. The error names the tables and counts.
#
# Set to "true" (exactly) to have boot recreate the missing `agents` rows
# instead — one per dangling id, in the org most of its referencing rows carry,
# marked "(recovered by migration v11)" and offline. NOTHING IS DELETED; the
# repair is recorded in audit_log under `migration.agent_fk_recover`. Unset it
# again once the database is through: it is an unblock-my-boot switch, not a
# setting.
# COORDINATOR_ALLOW_MIGRATION_REPAIR=true
