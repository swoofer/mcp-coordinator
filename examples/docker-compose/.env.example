# Set this to your public domain (Caddy provisions TLS automatically
# via Let's Encrypt once DNS A/AAAA records point at this host).
COORDINATOR_PUBLIC_DOMAIN=coordinator.example.com

# Required when COORDINATOR_OAUTH_ENABLED=true
COORDINATOR_OAUTH_ENABLED=true
COORDINATOR_PUBLIC_URL=https://coordinator.example.com
COORDINATOR_GITHUB_CLIENT_ID=
COORDINATOR_GITHUB_CLIENT_SECRET=
COORDINATOR_GITHUB_ORG=

# Generate via: openssl rand -base64 32
# Must be >=32 bytes of entropy; the coordinator refuses to boot
# with a short or default-looking secret.
COORDINATOR_JWT_SECRET=

# Encrypt OAuth IdP tokens (idp_access_token, idp_refresh_token) at rest in
# coordinator.db. When unset, tokens are stored plaintext (warning logged at
# boot -- ERROR level in production).
# Generate: openssl rand -base64 32
# Security note: env vars are visible to `docker inspect <container>`. For
# production Docker deploys, mount the value via Docker/Kubernetes secret. A
# future version will support COORDINATOR_ENCRYPTION_KEY_FILE=<path> reading.
# COORDINATOR_ENCRYPTION_KEY=<32 random bytes, base64>

# If using `env_file: .env` in docker-compose.yml, the value will be visible via
# `docker inspect <container>`. Prefer Docker secrets:
#   secrets:
#     coordinator_encryption_key:
#       file: ./secrets/encryption_key
# And mount via COORDINATOR_ENCRYPTION_KEY_FILE (future support).
