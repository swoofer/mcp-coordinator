# GHES (GitHub Enterprise Server) configuration template.
# Replace github.example.com with your GHES URL.

COORDINATOR_OAUTH_ENABLED=true
COORDINATOR_PUBLIC_URL=https://coordinator.internal.example.com

# GHES domain. Used for the OAuth login + token endpoints
# (/login/oauth/authorize, /login/oauth/access_token).
COORDINATOR_GITHUB_AUTH_BASE_URL=https://github.example.com

# GHES REST API. Used for /user, /user/emails, /user/memberships/orgs.
# Note the /api/v3 suffix -- GHES exposes the REST API there,
# whereas github.com uses api.github.com (no suffix).
COORDINATOR_GITHUB_API_BASE_URL=https://github.example.com/api/v3

# OAuth app created at:
#   https://github.example.com/settings/applications/new
# (NOT at github.com -- the app must live in the GHES instance).
COORDINATOR_GITHUB_CLIENT_ID=
COORDINATOR_GITHUB_CLIENT_SECRET=

# The GHES org slug whose members are allowed to sign in.
# Must match the org's URL slug, not its display name.
COORDINATOR_GITHUB_ORG=

# >=32 bytes; generate via openssl rand -base64 32
COORDINATOR_JWT_SECRET=
