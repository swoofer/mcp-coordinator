# mcp-coordinator — systemd EnvironmentFile
#
# Install to /etc/mcp-coordinator/env, owned root:mcp-coordinator, mode 0640
# (it will hold secrets once you enable auth). Referenced by
# mcp-coordinator.service via EnvironmentFile=/etc/mcp-coordinator/env.
#
# Format is KEY=value, one per line, NO surrounding quotes and NO `export`
# (systemd parses this file itself — it is not sourced by a shell).

# --- Core (Phase 1, always read) -----------------------------------------

# HTTP listener: MCP + REST + SSE + dashboard. Default 3100.
PORT=3100

# Bind address. Default 127.0.0.1 (loopback only) — keep it that way and put
# a TLS-terminating reverse proxy in front (see README). Use 0.0.0.0 ONLY if
# you intentionally expose it on a trusted LAN with no proxy.
COORDINATOR_BIND=127.0.0.1

# Embedded MQTT TCP broker port. Default 1883 (bound to COORDINATOR_BIND).
# COORDINATOR_MQTT_TCP_PORT=1883

# Persistent data directory (SQLite DB, run config, registration files).
# MUST match WorkingDirectory / StateDirectory in the unit. Created mode 0700
# on first boot; the DB file is chmod 0600.
COORDINATOR_DATA_DIR=/var/lib/mcp-coordinator

# NODE_ENV=production tightens a few boot-time warnings into errors.
NODE_ENV=production

# --- Authentication (optional, off by default) ---------------------------
#
# Out of the box the coordinator runs open (Phase 1, no auth) — fine only on
# loopback behind a proxy that enforces access. To require Bearer JWTs, or to
# turn on full OAuth 2.1 sign-in (GitHub / Google / OIDC), org allowlists,
# and the audit chain, follow the end-to-end walkthrough:
#
#   docs/onboarding-self-host.md
#
# Keep every secret below as a placeholder in version control; generate real
# values on the host with `openssl rand -base64 32` and never commit them.

# Simple Bearer-JWT gate on /api/* (independent of full OAuth).
# COORDINATOR_AUTH_ENABLED=true
# COORDINATOR_JWT_SECRET=__GENERATE_WITH_openssl_rand_base64_32__

# Full Phase 2 OAuth. When enabled, COORDINATOR_PUBLIC_URL must be the
# externally reachable https:// URL (the reverse-proxy hostname), used as the
# JWT issuer and OAuth redirect base. See the onboarding doc for the rest.
# COORDINATOR_OAUTH_ENABLED=true
# COORDINATOR_PUBLIC_URL=https://coordinator.example.com
# COORDINATOR_JWT_SECRET=__GENERATE_WITH_openssl_rand_base64_32__
# COORDINATOR_GITHUB_CLIENT_ID=__from_github_oauth_app__
# COORDINATOR_GITHUB_CLIENT_SECRET=__from_github_oauth_app__
# COORDINATOR_GITHUB_ORG=__your-org-login__
# COORDINATOR_ENCRYPTION_KEY=__GENERATE_WITH_openssl_rand_base64_32__   # encrypt IdP tokens at rest
