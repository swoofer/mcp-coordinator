# Public domain. Traefik routes Host(`this`) to the coordinator and requests a
# Let's Encrypt certificate for it once DNS A/AAAA records point at this host.
COORDINATOR_PUBLIC_DOMAIN=coordinator.example.com

# Email for the Let's Encrypt ACME account (expiry notices, recovery). Required
# by the `le` certificatesresolver in docker-compose.yml.
ACME_EMAIL=admin@example.com

# --- Coordinator app config (same knobs as the docker-compose example) -------
COORDINATOR_OAUTH_ENABLED=true
COORDINATOR_PUBLIC_URL=https://coordinator.example.com
COORDINATOR_GITHUB_CLIENT_ID=
COORDINATOR_GITHUB_CLIENT_SECRET=
COORDINATOR_GITHUB_ORG=

# Generate via: openssl rand -base64 32
# Must be >=32 bytes of entropy; the coordinator refuses to boot with a short
# or default-looking secret.
COORDINATOR_JWT_SECRET=

# Optional: the MQTT-over-WebSocket path. Defaults to /mqtt. If you change it,
# the WebSocket still routes through the same Traefik router — no label change
# needed, since the router matches the whole Host, not a path.
# COORDINATOR_MQTT_WS_PATH=/mqtt
