{
  "name": "mcp-coordinator",
  "version": "1.0.1",
  "mcpName": "io.github.swoofer/mcp-coordinator",
  "description": "Embedded MQTT broker + MCP server for multi-agent coordination",
  "type": "module",
  "license": "MIT",
  "author": "Maxime Gagnon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swoofer/mcp-coordinator.git"
  },
  "homepage": "https://swoofer.github.io/mcp-coordinator",
  "bugs": {
    "url": "https://github.com/swoofer/mcp-coordinator/issues"
  },
  "keywords": [
    "mcp",
    "mqtt",
    "broker",
    "multi-agent",
    "coordination",
    "claude",
    "anthropic"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    }
  },
  "bin": {
    "mcp-coordinator": "./dist/cli/index.js"
  },
  "files": [
    "dist/src/",
    "dist/cli/",
    "dashboard/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cli": "tsx cli/index.ts",
    "start": "node dist/src/serve-http.js",
    "dev": "tsx src/serve-http.ts",
    "dev:stdio": "tsx src/index.ts",
    "perf:rotation": "tsx tests/perf/bench-refresh-rotation.ts",
    "perf:audit": "tsx tests/perf/bench-audit-queue.ts",
    "perf:token-epoch": "tsx tests/perf/bench-token-epoch.ts",
    "chaos:idp": "tsx tests/perf/chaos/idp-failure-injection.ts",
    "chaos:audit": "tsx tests/perf/chaos/audit-queue-overflow.ts",
    "format": "prettier --write \"{src,cli,tests,sdk/src}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,cli,tests,sdk/src}/**/*.{ts,tsx}\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "aedes": "^1.1.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cookie": "^1.1.1",
    "jose": "^6.2.3",
    "lru-cache": "^11.5.2",
    "mqtt": "^5.15.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tar": "^7.5.19",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^3.23.2",
    "msw": "^2.15.0",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-c": "^0.21.4",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-cpp": "^0.22.3",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.22.8",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-swift": "^0.6.0",
    "tree-sitter-typescript": "^0.21.2"
  },
  "pnpm": {
    "overrides": {
      "ip-address": "^10.2.0",
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "tree-sitter-cli",
      "tree-sitter-kotlin",
      "tree-sitter-swift"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
