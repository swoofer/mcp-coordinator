{
  "name": "mcp-coordinator",
  "version": "0.6.0",
  "mcpName": "io.github.swoofer/mcp-coordinator",
  "description": "Embedded MQTT broker + MCP server for multi-agent coordination",
  "type": "module",
  "license": "MIT",
  "author": "Maxime Gagnon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swoofer/mcp-coordinator.git"
  },
  "homepage": "https://swoofer.github.io/mcp-coordinator",
  "bugs": {
    "url": "https://github.com/swoofer/mcp-coordinator/issues"
  },
  "keywords": [
    "mcp",
    "mqtt",
    "broker",
    "multi-agent",
    "coordination",
    "claude",
    "anthropic"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    }
  },
  "bin": {
    "mcp-coordinator": "./dist/cli/index.js"
  },
  "files": [
    "dist/src/",
    "dist/cli/",
    "dashboard/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx cli/index.ts",
    "start": "node dist/src/serve-http.js",
    "dev": "tsx src/serve-http.ts",
    "dev:stdio": "tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "aedes": "^1.0.2",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "jose": "^6.2.2",
    "mqtt": "^5.15.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tar": "^7.4.3",
    "ws": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.21.2",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-rust": "^0.21.2",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-c": "^0.21.0",
    "tree-sitter-cpp": "^0.22.0",
    "tree-sitter-ruby": "^0.21.0",
    "tree-sitter-php": "^0.22.0",
    "tree-sitter-kotlin": "^0.3.0",
    "tree-sitter-swift": "^0.6.0",
    "tree-sitter-bash": "^0.21.0"
  },
  "overrides": {
    "ip-address": "^10.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
