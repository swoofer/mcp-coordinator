  "description": "mcp-coordinator Phase 2 auth, IdP, audit, and sweeper observability. Sources the dedicated /metrics/auth Prometheus registry declared in src/observability/metrics.ts.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Row 1 — Auth Activity",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "title": "Login attempts rate (by outcome)",
      "type": "timeseries",
      "id": 1,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(coordinator_auth_login_attempts_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "stacking": { "mode": "normal", "group": "A" }, "fillOpacity": 25 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "title": "Login failures (by reason)",
      "type": "timeseries",
      "id": 2,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(coordinator_auth_login_failure_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "title": "Login lockouts triggered (per hour)",
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        {
          "expr": "rate(coordinator_login_lockout_triggered_total[1h]) * 3600",
          "legendFormat": "lockouts/hr",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "title": "Active users (1h login-success proxy)",
      "type": "stat",
      "id": 4,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        {
          "expr": "sum(increase(coordinator_auth_login_success_total[1h]))",
          "legendFormat": "successful logins last 1h",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
