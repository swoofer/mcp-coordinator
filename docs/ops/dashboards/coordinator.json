    {
      "title": "IdP cache hit rate",
      "type": "gauge",
      "id": 11,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        {
          "expr": "coordinator_idp_cache_hits_total / clamp_min(coordinator_idp_cache_hits_total + coordinator_idp_cache_misses_total, 1)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
